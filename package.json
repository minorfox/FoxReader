{
  "name": "foxreader",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Pure-local offline desktop PDF paper manager and reader with out-of-band annotations.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-electron.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:db": "node scripts/run-db-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^5.3.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^39.8.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
